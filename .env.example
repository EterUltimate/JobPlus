# JobPlus Docker 部署环境变量配置
# 复制此文件为 .env 并根据实际情况修改

# PostgreSQL 配置
POSTGRES_DB=jobplus
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# 应用数据库连接配置
JOBPLUS_DB_URL=jdbc:postgresql://postgres:5432/jobplus
JOBPLUS_DB_USERNAME=postgres
JOBPLUS_DB_PASSWORD=postgres
JOBPLUS_DB_FALLBACK_ENABLED=true
JOBPLUS_SQLITE_URL=jdbc:sqlite:../data/jobplus-fallback.sqlite

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379

# Nacos 配置
NACOS_ADDR=nacos:8848

# JWT 配置（生产环境请务必修改）
JWT_SECRET=please-change-this-secret-at-least-256-bits-long
JWT_EXPIRATION_MS=86400000

# CORS 配置
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# 服务端口配置
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
USER_SERVICE_PORT=8082
JOB_SERVICE_PORT=8083
RESUME_SERVICE_PORT=8084
FRONTEND_PORT=3000
