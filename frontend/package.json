{
  "name": "jobplus-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "build:web": "vue-tsc && vite build",
    "build:backend": "node electron/build-backend.cjs",
    "build:dir": "npm run build:web && npm run build:backend && electron-builder --win dir --x64",
    "build:exe": "npm run build:web && npm run build:backend && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "vue-router": "^4.3.0",
    "pinia": "^2.1.7",
    "axios": "^1.7.0",
    "@vueuse/core": "^10.9.0",
    "element-plus": "^2.7.0",
    "@element-plus/icons-vue": "^2.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vue-tsc": "^2.0.0",
    "unplugin-auto-import": "^0.17.5",
    "unplugin-vue-components": "^0.26.0",
    "electron": "31.7.7",
    "electron-builder": "^25.1.8"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.jobplus.desktop",
    "productName": "JobPlus",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend-services",
        "to": "backend",
        "filter": [
          "*.jar"
        ]
      },
      {
        "from": "java-runtime",
        "to": "java-runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "description": "JobPlus desktop client",
  "author": "JobPlus"
}
